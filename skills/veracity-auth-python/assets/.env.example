# Copy to .env for local development. NEVER commit the real .env (it holds secrets).
# This is the local analog of `dotnet user-secrets`. Deployed: use Azure Key Vault.

APP_ENV=Development
APP_HOST=localhost
APP_PORT=54438
HTTPS_CERT_FILE=.certs/localhost.pem
HTTPS_KEY_FILE=.certs/localhost-key.pem

# Strategy: oidc (BFF web app) or jwt (stateless API)
AUTH_STRATEGY=oidc

# --- OIDC (BFF) ---
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace-with-your-client-secret
# Random 32+ byte string used to sign the session cookie. The skill should generate
# a strong value in the local .env during scaffolding.
SESSION_SECRET=replace-with-a-long-random-string
# Local development should run over HTTPS so the __Host- cookie stays valid
COOKIE_SECURE=true
# Seconds Authlib waits for the B2C metadata/token fetch. Default 30 (httpx's own default
# is only 5s). Raise it if you are behind a slow corporate/VPN proxy and login times out.
OIDC_HTTP_TIMEOUT=30
# Absolute OIDC callback URL registered with B2C (analog of .NET Veracity:CallbackPath).
# Leave empty for a single-origin deployment (derived from the request). When a
# veracity-auth-ui SPA fronts this BFF through the Vite dev proxy, set it to the SPA origin:
#   REDIRECT_URI=https://localhost:5173/auth/callback
REDIRECT_URI=

# --- JWT Bearer ---
JWT_AUDIENCE=00000000-0000-0000-0000-000000000000

# --- Veracity API client ---
# Veracity service this app is connected to — used by the V4 policy/validate endpoint. Not a
# secret. Leave empty if using v3 endpoints not requiring a service id.
SERVICE_ID=
SUBSCRIPTION_KEY=replace-with-your-ocp-apim-subscription-key

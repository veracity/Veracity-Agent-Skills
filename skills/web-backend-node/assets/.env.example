# Copy this file to .env.local and fill in your values.
# .env       -> committed, non-secret defaults
# .env.local -> gitignored, holds SECRETS for local development
#
# Secrets must ONLY live in .env.local locally, and in environment variables /
# Azure Key Vault when deployed.

NODE_ENV=development
PORT=54438

# ----- HTTPS for local dev (optional) -----
# Set both to serve the app over HTTPS. Generate a trusted localhost cert yourself
# (for example with mkcert; see https://github.com/FiloSottile/mkcert for setup) and
# point the vars below at the resulting cert/key files, e.g. certs/localhost.pem +
# certs/localhost-key.pem.
# TLS_CERT_FILE=certs/localhost.pem
# TLS_KEY_FILE=certs/localhost-key.pem

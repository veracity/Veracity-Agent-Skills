# Copy to .env for local development. NEVER commit the real .env.
# This is the local analog of `dotnet user-secrets`.

APP_ENV=Development
APP_HOST=localhost
APP_PORT=54438

# Local HTTPS certificate/key (generate a trusted localhost cert, e.g. with mkcert).
HTTPS_CERT_FILE=.certs/localhost.pem
HTTPS_KEY_FILE=.certs/localhost-key.pem
